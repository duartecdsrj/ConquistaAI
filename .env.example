APP_ENV=development
HTTP_PORT=8081
APP_DEBUG=true
APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081
MYSQL_DATABASE=concursos
MYSQL_USER=concursos
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=concursos
DB_USER=concursos
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ISSUER=concursos-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Identificador OAuth 2.0 do tipo Web; não inclua client secret na API ou SPA.
GOOGLE_OIDC_CLIENT_ID=
# Mesmo client ID público, injetado no Vite apenas para carregar o Google Identity Services.
VITE_GOOGLE_CLIENT_ID=
DISCOVERY_PROVIDER_BASE_URL=
DISCOVERY_ALLOWED_HOSTS=
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rede Docker do executor isolado de correções; ajuste quando o nome do projeto Compose mudar.
CORRECTION_CODEX_NETWORK=conquistaai_public
CORRECTION_WORKSPACE_VOLUME=conquistaai_correction_workspaces
CODEX_AUTH_VOLUME=conquistaai_codex_auth
